# Copy these into your hosting settings or a local .env file.
# Public settings (shipped to the browser). Defaults are the live Arc mainnet deployment; set the first two only to point at another contract.
VITE_PURSE_ADDRESS=0xC81332357d6832d5FDDd8eCDC884Ef4e461c422B
VITE_DEPLOY_BLOCK=29024415
VITE_CHAIN_ID=5042
VITE_RPC_URL=https://rpc.mainnet.arc.io
VITE_EXPLORER_URL=https://explorer.arc.io
VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Blocks per log query (default 2000).
VITE_LOG_RANGE=

# Server only (Vercel project settings). Never prefix with VITE_. Used by api/demo.ts.
DEMO_PRIVATE_KEY=
